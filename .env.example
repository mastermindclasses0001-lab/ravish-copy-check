# GEMINI_API_KEY: Primary Gemini AI API key (used for OCR scanning, book extraction & fallback grading).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional 2nd, 3rd, and 4th Gemini API keys from separate accounts for 4-way parallel fast copy scanning:
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""

# Optional Groq API key for 1-2 second final text grading of scanned student copies:
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional SMTP settings for automated Result Report Card PDF email delivery after test expiry
# Example for Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER="your@gmail.com", SMTP_PASS="16-letter-google-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
